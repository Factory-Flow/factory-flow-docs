{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Factory Flow",
  "colors": {
    "primary": "#0565ff",
    "light": "#0565ff",
    "dark": "#0565ff"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "dropdowns": [
          {
            "dropdown": "Factory Flow",
            "icon": "layout-dashboard",
            "description": "Monitor, configure, and self-host Factory Flow",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "getting-started/introduction",
                  "getting-started/quickstart",
                  "getting-started/concepts"
                ]
              },
              {
                "group": "Monitor",
                "pages": [
                  "monitor/analytics",
                  "monitor/layouts"
                ]
              },
              {
                "group": "Alerts",
                "pages": [
                  "monitor/alerts",
                  "configure/alert-rules",
                  "manage/organization/alert-groups"
                ]
              },
              {
                "group": "Configure",
                "pages": [
                  "configure/facilities",
                  "configure/lines",
                  "configure/machines",
                  "configure/shifts"
                ]
              },
              {
                "group": "Manage",
                "pages": [
                  "manage/team",
                  "manage/profile",
                  {
                    "group": "Organization",
                    "icon": "building-2",
                    "pages": [
                      "manage/organization",
                      "manage/organization/api-tokens",
                      "manage/organization/gateways"
                    ]
                  }
                ]
              },
              {
                "group": "Self-Hosted",
                "pages": [
                  "self-hosted/overview",
                  "self-hosted/installation",
                  "self-hosted/license",
                  {
                    "group": "Configure",
                    "icon": "sliders-horizontal",
                    "pages": [
                      "self-hosted/smtp",
                      "self-hosted/ldap",
                      "self-hosted/storage-paths",
                      "self-hosted/ssl-and-proxies"
                    ]
                  },
                  {
                    "group": "Operate",
                    "icon": "wrench",
                    "pages": [
                      "self-hosted/updates",
                      "self-hosted/backups",
                      "self-hosted/data-retention"
                    ]
                  },
                  {
                    "group": "Administration",
                    "icon": "shield",
                    "pages": [
                      "self-hosted/admin-management",
                      "self-hosted/cli-reference"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "dropdown": "Gateway",
            "icon": "server",
            "description": "Connect machines and collect data",
            "groups": [
              {
                "group": "Get Started",
                "pages": [
                  "gateway/overview",
                  "gateway/registration"
                ]
              },
              {
                "group": "Collect Data",
                "pages": [
                  {
                    "group": "Connections",
                    "icon": "cable",
                    "pages": [
                      "gateway/connections",
                      "gateway/connections/industrial",
                      "gateway/connections/streaming",
                      "gateway/connections/web-apis",
                      "gateway/connections/databases",
                      "gateway/connections/scan-network"
                    ]
                  },
                  {
                    "group": "Machines",
                    "icon": "cpu",
                    "pages": [
                      "gateway/machines",
                      "gateway/machines/mapping",
                      "gateway/machines/conversions",
                      "gateway/machines/checks"
                    ]
                  },
                  "gateway/data-flow"
                ]
              },
              {
                "group": "Monitor & Troubleshoot",
                "pages": [
                  "gateway/dashboard",
                  "gateway/logs",
                  "gateway/troubleshooting"
                ]
              },
              {
                "group": "Settings & Updates",
                "pages": [
                  {
                    "group": "Settings",
                    "icon": "settings",
                    "pages": [
                      "gateway/settings",
                      "gateway/settings/server",
                      "gateway/settings/collector",
                      "gateway/settings/connections",
                      "gateway/settings/logs",
                      "gateway/settings/application",
                      "gateway/settings/danger-zone"
                    ]
                  },
                  "gateway/updates",
                  "gateway/system-tray"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "API",
        "icon": "code",
        "openapi": "/api/openapi.json",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api/introduction"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "history",
        "pages": [
          {
            "group": "Factory Flow",
            "pages": [
              "changelog/app"
            ]
          },
          {
            "group": "Factory Flow Gateway",
            "pages": [
              "changelog/gateway"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "baseUrl": "https://app.factoryflow.io/api",
    "auth": {
      "method": "bearer",
      "name": "Authorization",
      "inputPrefix": "Bearer "
    },
    "playground": {
      "mode": "show"
    }
  },
  "openapi": "/api/openapi.json",
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Status",
        "href": "https://status.factoryflow.io"
      },
      {
        "label": "Support",
        "href": "mailto:support@factoryflow.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Factory Flow",
      "href": "https://app.factoryflow.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "appearance": {
    "default": "light"
  }
}
