{
    "openapi": "3.1.2",
    "info": {
        "title": "Factory Flow",
        "version": "0.0.1",
        "description": "Factory Flow public API. Authenticate using your organization API token as a Bearer token."
    },
    "servers": [
        {
            "url": "https://app.factoryflow.io/api",
            "description": "Live"
        },
        {
            "url": "https://demo.factoryflow.io/api",
            "description": "Demo"
        },
        {
            "url": "https://{host}/api",
            "description": "Self-hosted",
            "variables": {
                "host": {
                    "default": "your-server.example.com",
                    "description": "Your self-hosted Factory Flow server hostname"
                }
            }
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/production": {
            "post": {
                "operationId": "production",
                "description": "Report part count data for one or more machines in a single request (max 100).\nEach reading requires `machine_uuid` plus `part_count_total`. If only one of\n`part_count_good` or `part_count_bad` is provided the other is derived automatically.\nAll machines must belong to the authenticated organization and use the `factory_flow_api` data source.\n\nAn optional `recorded_at` ISO 8601 timestamp may be included on each reading to indicate\nwhen the data was actually captured. This supports gateways that buffer readings locally\nduring a connectivity loss and flush them once the connection resumes. When omitted, the\nserver records the current time. Historical readings (older than 10 seconds) bypass the\nper-machine rate limit since they represent replayed buffered data.\n\nFor gateway requests, the same `machine_uuid` may appear more than once in `readings`;\neach occurrence is validated and persisted as its own independent reading. This is\nintended for gateways replaying a backlog of buffered/historical readings for one\nmachine in a single request instead of issuing one request per reading \u2014 each entry\nshould carry its own `recorded_at`. When a request contains multiple readings for the\nsame machine, they are processed in `recorded_at` order (oldest first) regardless of\ntheir position in the array. Non-gateway (org-token) requests may not supply\n`recorded_at` and must still include each `machine_uuid` at most once per batch.\n\nReadings that fail business-logic checks (unknown UUID, per-machine rate limit, or a\nmachine restricted for exceeding the organization's plan limit) are returned in\n`rejected`; valid readings are always written. The response is 202 when at least one\nreading is accepted, 422 when all are rejected.\n\n**Batch rate limit:** 60 requests per minute per token/gateway. Exceeding this returns 429.\n\n**Per-machine rate limit:** each machine UUID may be written at most once every 10 seconds,\nglobally across all callers (API tokens and gateways). If another source wrote to the same\nmachine within that window, the reading is rejected with `error: \"Rate limit exceeded\"` and\na `retry_after` value (seconds) in the rejected entry. This limit is skipped for readings\nwith a `recorded_at` older than 10 seconds.",
                "summary": "Post production",
                "tags": [
                    "MachineProduction"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "readings": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "machine_uuid": {
                                                    "type": "string",
                                                    "format": "uuid"
                                                },
                                                "part_count_total": {
                                                    "type": "integer",
                                                    "minimum": 0
                                                },
                                                "part_count_good": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "minimum": 0
                                                },
                                                "part_count_bad": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "minimum": 0
                                                }
                                            },
                                            "required": [
                                                "machine_uuid",
                                                "part_count_total"
                                            ]
                                        },
                                        "minItems": 1,
                                        "maxItems": 100
                                    }
                                },
                                "required": [
                                    "readings"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "One or more readings accepted. `status` is `accepted` when all pass, `partial` when some are rejected.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "examples": [
                                                "accepted"
                                            ]
                                        },
                                        "accepted_count": {
                                            "type": "integer"
                                        },
                                        "rejected_count": {
                                            "type": "integer"
                                        },
                                        "rejected": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "index": {
                                                        "type": "integer"
                                                    },
                                                    "machine_uuid": {
                                                        "type": "string",
                                                        "format": "uuid",
                                                        "examples": [
                                                            "9d4e2f8a-1b3c-4d5e-6f7a-8b9c0d1e2f3a"
                                                        ]
                                                    },
                                                    "error": {
                                                        "type": "string",
                                                        "examples": [
                                                            "Rate limit exceeded"
                                                        ]
                                                    },
                                                    "retry_after": {
                                                        "type": "integer"
                                                    }
                                                },
                                                "required": [
                                                    "index",
                                                    "machine_uuid",
                                                    "error"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "accepted_count",
                                        "rejected_count"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "All readings rejected. Each entry includes the reason and, for rate-limited machines, a `retry_after` value.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "examples": [
                                                "All readings rejected"
                                            ]
                                        },
                                        "rejected": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "index": {
                                                        "type": "integer"
                                                    },
                                                    "machine_uuid": {
                                                        "type": "string",
                                                        "format": "uuid",
                                                        "examples": [
                                                            "9d4e2f8a-1b3c-4d5e-6f7a-8b9c0d1e2f3a"
                                                        ]
                                                    },
                                                    "error": {
                                                        "type": "string",
                                                        "examples": [
                                                            "Rate limit exceeded"
                                                        ]
                                                    },
                                                    "retry_after": {
                                                        "type": "integer"
                                                    }
                                                },
                                                "required": [
                                                    "index",
                                                    "machine_uuid",
                                                    "error"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "message",
                                        "rejected"
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Batch rate limit exceeded (60 requests per minute). Retry after the indicated number of seconds.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "examples": [
                                                "Too Many Requests"
                                            ]
                                        },
                                        "retry_after": {
                                            "type": "integer"
                                        }
                                    },
                                    "required": [
                                        "message",
                                        "retry_after"
                                    ]
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "This organization's subscription has ended (or, for self-hosted deployments, the license is missing or invalid). A subscription cancelled \"at period end\" still works until that period actually runs out.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "examples": [
                                                "This organization's subscription has ended."
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/machines": {
            "get": {
                "operationId": "machines.index",
                "tags": [
                    "Machines"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/MachineResource"
                                            }
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer"
                                                },
                                                "per_page": {
                                                    "type": "integer"
                                                },
                                                "total": {
                                                    "type": "integer"
                                                },
                                                "last_page": {
                                                    "type": "integer"
                                                }
                                            },
                                            "required": [
                                                "current_page",
                                                "per_page",
                                                "total",
                                                "last_page"
                                            ]
                                        },
                                        "links": {
                                            "type": "object",
                                            "properties": {
                                                "first": {
                                                    "type": "string"
                                                },
                                                "last": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "prev": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "next": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "first",
                                                "last",
                                                "prev",
                                                "next"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta",
                                        "links"
                                    ]
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "This organization's subscription has ended (or, for self-hosted deployments, the license is missing or invalid). A subscription cancelled \"at period end\" still works until that period actually runs out.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "examples": [
                                                "This organization's subscription has ended."
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "CycleTimeThreshold": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "value": {
                        "type": "number"
                    },
                    "color": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "downtime": {
                        "type": [
                            "boolean",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "label",
                    "value"
                ],
                "title": "CycleTimeThreshold"
            },
            "DetectionWindow": {
                "type": "object",
                "properties": {
                    "enabled": {
                        "type": "boolean"
                    },
                    "window_minutes": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    }
                },
                "required": [
                    "enabled",
                    "window_minutes"
                ],
                "title": "DetectionWindow"
            },
            "FacilityRef": {
                "type": "object",
                "properties": {
                    "uuid": {
                        "type": "string",
                        "format": "uuid",
                        "examples": [
                            "7c3a1b2d-4e5f-6a7b-8c9d-0e1f2a3b4c5d"
                        ]
                    },
                    "name": {
                        "type": "string",
                        "examples": [
                            "Main Factory Floor"
                        ]
                    },
                    "location": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "uuid",
                    "name",
                    "location"
                ],
                "title": "FacilityRef"
            },
            "LineRef": {
                "type": "object",
                "properties": {
                    "uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "part_number": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "uuid",
                    "name",
                    "part_number",
                    "description"
                ],
                "title": "LineRef"
            },
            "MachineDataSource": {
                "type": "string",
                "enum": [
                    "none",
                    "factory_flow_api",
                    "factory_flow_gateway"
                ],
                "title": "MachineDataSource"
            },
            "MachineResource": {
                "type": "object",
                "properties": {
                    "uuid": {
                        "type": "string",
                        "format": "uuid",
                        "examples": [
                            "9d4e2f8a-1b3c-4d5e-6f7a-8b9c0d1e2f3a"
                        ]
                    },
                    "name": {
                        "type": "string",
                        "examples": [
                            "CNC Mill #1"
                        ]
                    },
                    "facility": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/FacilityRef"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "machine_type": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/MachineTypeRef"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "data_source": {
                        "$ref": "#/components/schemas/MachineDataSource"
                    },
                    "shifts": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ShiftRef"
                        }
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/LineRef"
                        }
                    },
                    "analytics": {
                        "type": "object",
                        "properties": {
                            "expected_cycle_time": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "cycle_time_thresholds": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/CycleTimeThreshold"
                                }
                            },
                            "oee_thresholds": {
                                "anyOf": [
                                    {
                                        "$ref": "#/components/schemas/OeeThresholds"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "shift_change_detection": {
                                "$ref": "#/components/schemas/DetectionWindow"
                            },
                            "break_creep_detection": {
                                "$ref": "#/components/schemas/DetectionWindow"
                            }
                        },
                        "required": [
                            "expected_cycle_time",
                            "cycle_time_thresholds",
                            "oee_thresholds",
                            "shift_change_detection",
                            "break_creep_detection"
                        ]
                    }
                },
                "required": [
                    "uuid",
                    "name",
                    "data_source",
                    "analytics"
                ],
                "title": "MachineResource"
            },
            "MachineTypeRef": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "examples": [
                            3
                        ]
                    },
                    "name": {
                        "type": "string",
                        "examples": [
                            "CNC Mill"
                        ]
                    }
                },
                "required": [
                    "id",
                    "name"
                ],
                "title": "MachineTypeRef"
            },
            "OeeThresholdConfig": {
                "type": "object",
                "properties": {
                    "green": {
                        "type": "number"
                    },
                    "yellow": {
                        "type": "number"
                    },
                    "orange": {
                        "type": "number"
                    }
                },
                "required": [
                    "green",
                    "yellow",
                    "orange"
                ],
                "title": "OeeThresholdConfig"
            },
            "OeeThresholds": {
                "type": "object",
                "properties": {
                    "overall": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/OeeThresholdConfig"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "availability": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/OeeThresholdConfig"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "performance": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/OeeThresholdConfig"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "quality": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/OeeThresholdConfig"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "title": "OeeThresholds"
            },
            "ShiftRef": {
                "type": "object",
                "properties": {
                    "uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "uuid",
                    "name"
                ],
                "title": "ShiftRef"
            }
        }
    }
}